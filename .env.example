# Copia este archivo como .env.local (local) o captura estas variables en
# Vercel > Project > Settings > Environment Variables. NUNCA subas valores reales.

# Conexión de la APP con el rol de mínimo privilegio "somexa_consulta"
# (pooler de Supabase, modo transacción, puerto 6543). Ejemplo de forma:
# postgres://somexa_consulta.<REF_PROYECTO>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Sal secreta para el hash de IPs del límite de intentos (mínimo 32 caracteres).
# Genérala con:  openssl rand -hex 32
RATE_LIMIT_SALT=

# SOLO para el script de importación (en tu computadora). NO la pongas en Vercel.
# Cadena de conexión del rol "postgres" de Supabase (Project Settings > Database).
ADMIN_DATABASE_URL=
